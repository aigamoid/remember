# Docker ビルドコンテキストから除外する。
# 実行時に compose の bind mount / env_file で渡るものはイメージに不要。
# （特に data/ は Postgres/Qdrant のボリュームで root 所有のため、
#  除外しないと build context 収集時に "permission denied" でビルドが落ちる。）

.git/
.gitignore

# ランタイムで渡すので焼かない
data/                              # Postgres/Qdrant ボリューム（compose で bind mount）
.env                               # env_file で注入（イメージに秘密を入れない）
config.yml                         # /app/config.yml に bind mount（:ro）
moimoichan_Discordbot/config.yml   # 同上（bot）

# 開発・テスト由来の生成物（イメージ不要）
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
output/
tests/

# OS / エディタ
.DS_Store
