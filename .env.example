DISCORD_TOKEN=your-discord-bot-token
OPENAI_API_KEY=your-openai-api-key
# OpenRouterキー（config.yml の openai.api_key が空の場合に使用）
# OPENROUTER_API_KEY=your-openrouter-api-key
# Postgres（composeのpostgresサービスと合わせる）
POSTGRES_PASSWORD=oracle
DATABASE_URL=postgresql://oracle:oracle@localhost:5432/oracle
# Bot → APIサーバの接続先（composeでは自動設定されるため通常は不要）
# ORACLE_API_URL=http://localhost:8000
