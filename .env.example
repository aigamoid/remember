DISCORD_TOKEN=your-discord-bot-token
OPENAI_API_KEY=your-openai-api-key
# OpenRouterキー（config.yml の openai.api_key が空の場合に使用）
# OPENROUTER_API_KEY=your-openrouter-api-key
# Jina Reranker キー（OI-9: rag.reranker.enabled=true の時に必要）
# JINA_API_KEY=your-jina-api-key
# Postgres（composeのpostgresサービスと合わせる）
POSTGRES_PASSWORD=oracle
DATABASE_URL=postgresql://oracle:oracle@localhost:5432/oracle
# Bot → APIサーバの接続先（composeでは自動設定されるため通常は不要）
# ORACLE_API_URL=http://localhost:8000
# Bot → APIサーバの共有シークレット（設定すると /chat・/remember が認証必須）
# 本番/共有環境では必ず長いランダム文字列を設定し、bot/api の両方に同じ値を渡す
# ORACLE_API_TOKEN=change-this-to-a-long-random-secret
# 管理ポータル（src/admin）のログインパスワード（未設定だとログイン不可）
ADMIN_PASSWORD=change-me
# セッション署名鍵（任意。未設定なら ADMIN_PASSWORD から導出）
# ADMIN_SESSION_SECRET=some-long-random-string
