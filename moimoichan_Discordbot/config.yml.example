oracle:
  api_url: "http://localhost:8000"  # waiwai-oracle APIサーバ（環境変数 ORACLE_API_URL が優先）
  chat_timeout: 90                   # Chat API タイムアウト（秒）

discord:
  mention_only: true   # true = @メンション時のみ応答 / false = 全メッセージに応答
  # trigger_channel_ids: []  # 空=全チャンネル / 数値IDのリストで絞り込み可
  #   例: [123456789, 987654321]
