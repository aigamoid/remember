guild_id: 123456789          # 手動スクリプト実行時の対象DiscordサーバーID（通常運用はワーカーが自動判別）

crawl:
  exclude_channels:          # 除外チャンネル名リスト（手動クロール時のみ。ワーカーは許可リスト方式）
    - bot-log
    - spam
  exclude_channel_ids:       # IDでの除外（名前変更に強い）
    - 987654321

chunk:
  time_gap_minutes: 60       # N分以上の間隔があればチャンク境界（会話スレッド単位）
  max_chunk_messages: 30     # 1チャンクに含める最大メッセージ数
  min_content_length: 10     # これ未満の文字数メッセージはスキップ
  short_reply_max_chars: 10  # これ以下の短文は直前チャンクに吸収（疑似reply_to）
  timezone_offset: 9         # タイムスタンプ表示のUTCオフセット（JST=9）

openai:
  api_key: ""              # 空なら環境変数 OPENAI_API_KEY を使用
  base_url: ""             # 空=OpenAIデフォルト / OpenRouter: https://openrouter.ai/api/v1

qdrant:
  url: "http://localhost:6333"   # compose内のコンテナからは環境変数 QDRANT_URL が優先される
  collection: "waiwai_chunks"    # コレクション名（全guild共有・payloadのguild_idで分離）

embedding:
  model: "text-embedding-3-small"  # OpenAI embeddingモデル（APIキーは .env の OPENAI_API_KEY）
  dimensions: 1536
  batch_size: 100                  # 1回のembedding APIに渡すチャンク数

rag:
  rewriter_model: "google/gemini-2.5-flash"   # Query Rewriter（OpenRouter経由）
  answer_model: "moonshotai/kimi-k2-0905"     # 回答生成LLM（OpenRouter経由）
  top_k: 10                                   # 回答に渡すチャンク数（リランク有効時はリランク後の件数）
  rewriter_max_tokens: 256                    # 書き換え出力の上限（過大なtoken要求で残高不足になるのを防ぐ）
  history_max_turns: 5                        # マルチターン会話で渡す直近やり取りの上限ペア数（0で無効・OI-10）
  history_max_chars: 4000                      # 履歴の合計文字数バジェット（超過分は古い方から落とす・長い回答のtoken膨張対策）
  rewriter_history_max_turns: 2               # Query Rewriterに渡す履歴ペア数（指示語解決用に少なめ・token二重計上を抑制）
  rewriter_history_max_chars: 1000            # Query Rewriterに渡す履歴の文字数バジェット
  guild_name: "みんなのサーバー"                  # プロンプト用サーバー名のデフォルト（Bot経由なら実サーバー名が優先）
  debug_trace: false                          # OI-21: 質問/ヒットチャンク/回答を chat_trace に保存（デバッグ用・既定OFF）。本番はプライバシー上 false 推奨
  memory_enabled: false                       # OI-24: 「覚えておいて」で教わった事実(memories)を回答プロンプトに注入（既定OFF）
  search_gate: true                           # OI-23: 雑談/挨拶/一般質問など過去ログ参照が不要な入力は検索をスキップ（コスト/レイテンシ削減・既定ON）。Rewriterが[NO_SEARCH]判定したら検索しない
  mimic_enabled: false                        # #49: 「真似っこ」モード（/oracle mimic）を有効化（既定OFF）。対象メンバーの口調・性格を真似て回答
  mimic:                                      # #49: 真似っこの調整（mimic_enabled=true のときだけ効く）
    sample_limit: 300                         # 人格カード生成時に対象者の発言を最大何件まで使うか
    min_sample_count: 30                      # これ未満は confidence=low（特徴が薄ければ開始を断ることもある）
    require_optin: false                      # MVPは false。公開/課金前は true（本人の事前同意を必須化）にする
  hybrid:                                     # #54: ハイブリッド検索（dense + BM25 sparse を RRF融合）。日本語はSudachiPyで分割
    enabled: false                            # true で有効化。本番ONは実データA/Bで効果実証してから（要: 全チャンク再インデックス）
    prefetch_k: 30                            # 各レーン(dense/sparse)で融合前に取る候補数
  auto_memory:                                # #56 案C: 会話から記憶を自動抽出して育てる（mem0方式）
    enabled: false                            # 既定OFF。ONでも抽出は全件pending（admin承認待ち）として着地し、承認するまで回答に出ない
    max_chunks: 30                            # 1回の取り込み後抽出で見る最近チャンク数（許可ch限定）
    max_tokens: 800                           # 突合LLMの出力上限（JSON配列が途中で切れると抽出0件になるため広めに取る）
  reranker:                                   # OI-9: 検索結果のリランキング（任意・既定オフ）
    enabled: false                            # true で有効化（APIキー JINA_API_KEY が必要）
    provider: "jina"                          # 現状 jina のみ対応
    model: "jina-reranker-v2-base-multilingual"
    top_n: 30                                 # リランク前に dense で取る候補数（→ top_k 件に精選）

contextualizer:
  model: "gpt-4.1-nano"   # コンテキスト生成モデル
  preceding_messages: 10  # 直前のメッセージ参照数
  max_retries: 3          # API エラー時のリトライ回数
  retry_delay: 1.0        # リトライ間隔（秒）
  concurrency: 10         # 同時実行数（--concurrency 引数で上書き可）

# usage_log のコスト推定に使う単価（USD / 100万トークン）。
# ※価格は変動するので最新値に各自で更新すること（未掲載モデルはコスト0で計上）。
pricing:
  "google/gemini-2.5-flash": {input: 0.30, output: 2.50}
  "moonshotai/kimi-k2-0905": {input: 0.60, output: 2.50}
  "gpt-4.1-nano":            {input: 0.10, output: 0.40}
  "text-embedding-3-small":  {input: 0.02, output: 0.0}
  "jina-reranker-v2-base-multilingual": {input: 0.02, output: 0.0}  # ※概算・要更新

worker:
  poll_interval_seconds: 10  # ジョブキューの確認間隔（秒）
  sync_interval_hours: 24    # 定期syncの間隔（最後の取り込み完了からの経過時間）
